#!/usr/bin/env bash
# Pre-commit hook: fast subset only. The complete gate is `npm run verify:ci`.
# when system.json or lang/*.json is staged. Opt-in once per clone:
#
#   git config core.hooksPath .githooks

set -eu

STAGED=$(git diff --cached --name-only --diff-filter=ACMR || true)
[ -z "$STAGED" ] && exit 0

fail() { echo "pre-commit: $1" >&2; exit 1; }

npm run verify:fast 2>&1 || fail "verify:fast failed — run npm run verify:fast"

while IFS= read -r f; do
  [ -f "$f" ] || continue
  case "$f" in
    *.mjs)
      node --check "$f" || fail "syntax error in $f"
      ;;
    *.json)
      node -e "JSON.parse(require('fs').readFileSync(process.argv[1],'utf8'))" "$f" \
        || fail "invalid JSON in $f"
      ;;
  esac
done <<< "$STAGED"

exit 0
