{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node --check:*)",
      "Bash(node --test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run fmt:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run verify:all)",
      "Bash(npm run test:e2e)",
      "Bash(npx playwright install chromium)",
      "Bash(npm test)",
      "Bash(npm ci:*)",
      "Bash(npx biome:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-list:*)",
      "Bash(awk:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(pdftotext:*)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:foundryvtt.com)",
      "WebFetch(domain:foundryvtt.wiki)",
      "WebSearch"
    ],
    "deny": [
      "Edit(/.git/**)",
      "Edit(/.agents/**)",
      "Edit(/.codex/**)",
      "Edit(/vendor/**)",
      "Edit(/books/**)",
      "Edit(/.pdf-extract/**)",
      "Edit(/LICENSE)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npx * install *)",
      "Bash(rm -rf:*)",
      "Bash(rm -rf /)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)"
    ]
  },
  "env": {
    "DEADLANDS_DEV": "1"
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": [
        "./.git",
        "./.agents",
        "./.codex",
        "./vendor",
        "./books",
        "./.pdf-extract",
        "./LICENSE"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "codeload.github.com",
        "registry.npmjs.org",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com",
        "foundryvtt.com",
        "*.foundryvtt.com",
        "localhost",
        "127.0.0.1"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git config core.hooksPath .githooks >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-write.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-extract-verify.sh",
            "if": "Bash(*extract-pdf.sh *)",
            "statusMessage": "PDF quality gate"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protect-paths.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/stop-verify.sh",
            "timeout": 120,
            "statusMessage": "verify:all"
          }
        ]
      }
    ]
  }
}
