{{!-- Gear: armor, general gear, ammo, edges & hindrances — run-in prose (M3.5).
     No item is clickable: there was no item-open handler on the old <li>
     markup either (data-item-id had no click binding anywhere in the sheet),
     so nothing is lost, and adding click-to-open is a new feature outside a
     style migration, not a preserved one. --}}
<section class="tab dlc-gear {{tab.cssClass}}" data-group="sheet" data-tab="gear">
  {{#if items.armor.length}}
  <p class="dlc-gear-line">
    <span class="dlc-gear-cat">{{localize 'DEADLANDS.Sheet.Section.Armor'}}</span> —
    {{#each items.armor as |item|}}{{item.name}}{{#unless @last}}; {{/unless}}{{/each}}.
  </p>
  {{else}}
  <p class="dlc-empty">{{localize 'DEADLANDS.Sheet.Empty.Armor'}}</p>
  {{/if}}

  {{#if items.gear.length}}
  <p class="dlc-gear-line">
    <span class="dlc-gear-cat">{{localize 'DEADLANDS.Sheet.Section.Gear'}}</span> —
    {{#each items.gear as |item|}}{{item.name}}{{#unless @last}}; {{/unless}}{{/each}}.
  </p>
  {{else}}
  <p class="dlc-empty">{{localize 'DEADLANDS.Sheet.Empty.Gear'}}</p>
  {{/if}}

  {{#if items.ammo.length}}
  <p class="dlc-gear-line">
    <span class="dlc-gear-cat">{{localize 'DEADLANDS.Sheet.Section.Ammo'}}</span> —
    {{#each items.ammo as |item|}}{{item.name}}{{#unless @last}}; {{/unless}}{{/each}}.
  </p>
  {{else}}
  <p class="dlc-empty">{{localize 'DEADLANDS.Sheet.Empty.Ammo'}}</p>
  {{/if}}

  {{#if items.edge.length}}
  <p class="dlc-gear-line">
    <span class="dlc-gear-cat">{{localize 'DEADLANDS.Sheet.Section.Edges'}}</span> —
    {{#each items.edge as |item|}}{{item.name}}{{#unless @last}}; {{/unless}}{{/each}}.
  </p>
  {{else}}
  <p class="dlc-empty">{{localize 'DEADLANDS.Sheet.Empty.Edges'}}</p>
  {{/if}}

  {{#if items.hindrance.length}}
  <p class="dlc-gear-line hindrances">
    <span class="dlc-gear-cat">{{localize 'DEADLANDS.Sheet.Section.Hindrances'}}</span> —
    {{#each items.hindrance as |item|}}{{item.name}}{{#unless @last}}; {{/unless}}{{/each}}.
  </p>
  {{else}}
  <p class="dlc-empty">{{localize 'DEADLANDS.Sheet.Empty.Hindrances'}}</p>
  {{/if}}
</section>
