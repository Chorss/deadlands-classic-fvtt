{{!-- Tab navigation for the sheet group — the "rail" (D2). `tabs` must stay on the
     nav: ApplicationV2's native changeTab() queries `.tabs [data-group][data-tab]`
     to toggle `.active`, independent of the dlc-rail-item styling hook. --}}
<nav class="tabs dlc-rail" data-group="sheet">
  {{#each tabs}}
  <a class="dlc-rail-item {{this.cssClass}}" data-action="tab" data-group="{{this.group}}" data-tab="{{this.id}}">
    <span>{{localize this.label}}</span>
  </a>
  {{/each}}
</nav>
