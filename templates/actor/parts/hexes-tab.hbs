{{!-- Hexes tab: hexslingin' aptitude, last card draw, hex list. dlc p.194, hnh p.10-14. --}}
<section class="tab dlc-hexes {{tab.cssClass}}" data-group="sheet" data-tab="hexes">

  <div class="dlc-section-head">
    <h2 class="dlc-section-title">{{localize "DEADLANDS.Huckster.Hexslingin.Label"}}</h2>
    <span class="dlc-rule-fill"></span>
    {{#if backlashPending}}
    <span class="dlc-pill dlc-pill-blood">{{localize "DEADLANDS.Huckster.BacklashPending"}}</span>
    {{/if}}
  </div>

  <div class="dlc-hexslingin-row">
    <span class="dlc-hexslingin-stat">
      <label for="dlc-hexslingin-level">{{localize "DEADLANDS.Huckster.Hexslingin.Level"}}</label>
      <input type="number" id="dlc-hexslingin-level" class="dlc-num" min="0" name="{{hexslingin.levelPath}}"
        value="{{hexslingin.level}}" {{#unless editable}}disabled{{/unless}} />
    </span>
    <span class="dlc-hexslingin-divider"></span>
    <span class="dlc-hexslingin-stat">
      <label for="dlc-hexslingin-mod">{{localize "DEADLANDS.Huckster.Hexslingin.Modifier"}}</label>
      <input type="number" id="dlc-hexslingin-mod" class="dlc-num" name="{{hexslingin.modifierPath}}"
        value="{{hexslingin.modifier}}" {{#unless editable}}disabled{{/unless}} />
    </span>

    {{#if lastDraw.length}}
    <span class="dlc-hexslingin-divider"></span>
    <span class="dlc-last-draw">
      <span class="dlc-last-draw-label">{{localize "DEADLANDS.Huckster.LastDraw.Label"}}</span>
      <ul class="dlc-card-row">
        {{#each lastDraw as |card|}}
        <li class="dlc-drawn-card {{#if card.joker}}dlc-joker dlc-joker-{{card.joker}}{{/if}}">
          {{#if card.joker}}
            <span class="dlc-card-rank">★</span>
            <span class="dlc-card-suit">{{localize (concat "DEADLANDS.Combat.Card." (capitalize card.joker) "Joker")}}</span>
          {{else}}
            <span class="dlc-card-rank">{{card.rank}}</span>
            <span class="dlc-card-suit" data-suit="{{card.suit}}">{{card.suit}}</span>
          {{/if}}
        </li>
        {{/each}}
      </ul>
    </span>
    {{/if}}
  </div>

  <div class="dlc-section-head">
    <h2 class="dlc-section-title">{{localize "DEADLANDS.Huckster.Section.Hexes"}}</h2>
    <span class="dlc-rule-fill"></span>
  </div>

  {{#if hexes.length}}
  <table class="dlc-hex-table">
    <thead>
      <tr class="dlc-hex-head">
        <th>{{localize "DEADLANDS.Huckster.HexTable.Name"}}</th>
        <th>{{localize "DEADLANDS.Huckster.HexTable.Trait"}}</th>
        <th>{{localize "DEADLANDS.Huckster.HexTable.Hand"}}</th>
        <th>{{localize "DEADLANDS.Huckster.HexTable.Speed"}}</th>
        <th>{{localize "DEADLANDS.Huckster.HexTable.Duration"}}</th>
        <th>{{localize "DEADLANDS.Huckster.HexTable.Range"}}</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each hexes as |hex|}}
      <tr class="dlc-hex-row" data-hex-id="{{hex.id}}">
        <td class="dlc-hex-name">
          <img class="dlc-item-img" src="{{hex.img}}" alt="{{hex.name}}" />
          {{hex.name}}
        </td>
        <td class="dlc-num">{{localize hex.traitLabel}}</td>
        <td class="dlc-num">{{localize hex.handLabel}}</td>
        <td class="dlc-num">{{hex.speed}}</td>
        <td class="dlc-num">{{hex.duration}}</td>
        <td class="dlc-num">{{hex.range}}</td>
        <td class="dlc-hex-actions">
          {{#if @root.editable}}
          <button type="button" class="dlc-btn-primary dlc-cast-btn"
            data-action="castHex" data-hex-id="{{hex.id}}">
            {{localize "DEADLANDS.Huckster.Cast.Button"}}
          </button>
          {{/if}}
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="dlc-empty">{{localize "DEADLANDS.Sheet.Empty.Hexes"}}</p>
  {{/if}}

</section>
