{{!-- Sheet header: portrait, name + archetype line, Fate Chips, secondary stats. --}}
<header class="dlc-sheet-header">
  <div class="dlc-header-top">
    <img class="dlc-portrait" src="{{actor.img}}" data-edit="img" alt="{{actor.name}}" />

    <div class="dlc-header-main">
      <input class="dlc-charname" type="text" name="name" value="{{actor.name}}"
        placeholder="{{localize 'DEADLANDS.Sheet.NamePlaceholder'}}"
        aria-label="{{localize 'DEADLANDS.Sheet.NamePlaceholder'}}"
        {{#unless editable}}disabled{{/unless}} />
      <p class="dlc-archetype-line">{{localize archetypeLabelKey}}</p>
    </div>

    {{#if chips.length}}
    <ul class="dlc-chip-row">
      {{#each chips as |chip|}}
      <li class="dlc-chip dlc-chip-{{chip.color}}">
        <label class="dlc-chip-label" for="dlc-chip-{{chip.color}}">{{localize chip.label}}</label>
        <input type="number" class="dlc-chip-token" id="dlc-chip-{{chip.color}}" min="0" name="{{chip.path}}"
          value="{{chip.value}}" {{#unless editable}}disabled{{/unless}} />
      </li>
      {{/each}}
    </ul>
    {{/if}}

    {{!-- Whole-sheet edit-mode toggle (D1) — reveals the raw die-count/type/modifier
         controls on the Traits tab. See BaseCharacterSheet#toggleEditMode. --}}
    <button type="button" class="dlc-edit-toggle-btn dlc-btn-ghost" data-action="toggleEditMode"
      aria-pressed="false" title="{{localize 'DEADLANDS.Sheet.EditMode.Toggle'}}">
      <i class="fas fa-pen" aria-hidden="true"></i>
      <span class="sr-only">{{localize 'DEADLANDS.Sheet.EditMode.Toggle'}}</span>
    </button>
  </div>

  <div class="dlc-secondary">
    <div class="dlc-wind">
      <div class="dlc-wind-head">
        <span class="dlc-wind-label">{{localize 'DEADLANDS.Sheet.Wind'}}</span>
        <span class="dlc-stat-pair">
          <span class="dlc-wind-value dlc-num">{{system.wind.value}}</span>
          <span class="dlc-sep">/</span>
          <span class="dlc-wind-max dlc-num">{{system.wind.max}}</span>
        </span>
      </div>
    </div>
    <span class="dlc-divider" aria-hidden="true"></span>

    <label class="dlc-stat">
      <span class="dlc-stat-label">{{localize 'DEADLANDS.Sheet.Pace'}}</span>
      <span class="dlc-stat-value dlc-num">{{system.pace}}</span>
    </label>
    <span class="dlc-divider" aria-hidden="true"></span>

    <label class="dlc-stat">
      <span class="dlc-stat-label">{{localize 'DEADLANDS.Sheet.Size'}}</span>
      <input type="number" class="dlc-stat-value dlc-num" name="system.size" value="{{system.size}}" {{#unless editable}}disabled{{/unless}} />
    </label>
    <span class="dlc-divider" aria-hidden="true"></span>

    <label class="dlc-stat">
      <span class="dlc-stat-label">{{localize 'DEADLANDS.Sheet.Grit'}}</span>
      <input type="number" class="dlc-stat-value dlc-num" name="system.grit" value="{{system.grit}}" {{#unless editable}}disabled{{/unless}} />
    </label>
    <span class="dlc-divider" aria-hidden="true"></span>

    <label class="dlc-stat">
      <span class="dlc-stat-label">{{localize 'DEADLANDS.Sheet.Bounty'}}</span>
      <input type="number" class="dlc-stat-value dlc-num" name="system.bounty" value="{{system.bounty}}" {{#unless editable}}disabled{{/unless}} />
    </label>
  </div>
</header>
