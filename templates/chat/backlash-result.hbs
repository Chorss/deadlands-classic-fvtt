{{!-- GM-whispered chat card for Extended Backlash Table result. hnh p.101-102. --}}
<div class="dlc-chat-card dlc-night dlc-backlash-result">
  <header class="dlc-chat-header dlc-backlash-header">
    {{localize "DEADLANDS.Huckster.Backlash.Header"}}
  </header>

  <div class="dlc-backlash-body">
    <p>
      <strong>{{actorName}}</strong> —
      {{localize "DEADLANDS.Huckster.Backlash.Casting"}} <em>{{hexName}}</em>
    </p>
    <p class="dlc-backlash-roll">
      {{localize "DEADLANDS.Huckster.Backlash.Roll"}}: <strong>{{roll}}</strong>
    </p>
    <p class="dlc-backlash-entry">
      <strong>{{localize entryKey}}</strong>
    </p>
    <p class="dlc-backlash-note">{{localize noteKey}}</p>

    {{#if stunDamage}}
    <p class="dlc-backlash-gate">
      {{localize "DEADLANDS.Huckster.Backlash.Gate.Damage"}}: <strong>{{stunDamage}}</strong>
      {{#if stunUnconscious}}
        — {{localize "DEADLANDS.Huckster.Backlash.Gate.Unconscious"}}
      {{else}}
        — {{localize "DEADLANDS.Huckster.Backlash.Gate.Conscious"}}
      {{/if}}
    </p>
    {{/if}}
    {{#if scartTotal}}
    <p class="dlc-backlash-gate">
      {{localize "DEADLANDS.Huckster.Backlash.Gate.ScartRoll"}}: <strong>{{scartTotal}}</strong>
    </p>
    {{/if}}
    {{#if marshalWindLost}}
    <p class="dlc-backlash-gate dlc-gm-note">
      {{localize "DEADLANDS.Huckster.Backlash.Gate.WindLost"}}: <strong>{{marshalWindLost}}</strong>
      — {{localize "DEADLANDS.Huckster.Backlash.Gate.MarshalCall"}}
    </p>
    {{/if}}

    {{#if hexSucceeds}}
    <p class="dlc-backlash-succeeds">{{localize "DEADLANDS.Huckster.Backlash.HexSucceeds"}}</p>
    {{/if}}
  </div>

  <footer class="dlc-chat-source">{{localize "DEADLANDS.Huckster.Backlash.Source"}}</footer>
</div>
