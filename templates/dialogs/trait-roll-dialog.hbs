{{!-- Trait / Aptitude roll dialog: TN, flat modifier, white chip spend. --}}
<form class="dlc-roll-dialog">
  <div class="dlc-dialog-kicker">{{localize 'DEADLANDS.Dialog.TraitRoll.Title'}}</div>
  <div class="dlc-dialog-title">{{label}}</div>

  {{#if unskilled}}
  <p class="dlc-unskilled-warn">{{localize 'DEADLANDS.Roll.Unskilled'}} (−4)</p>
  {{/if}}

  <div class="dlc-dialog-field">
    <span class="dlc-dialog-field-label">{{localize 'DEADLANDS.Dialog.TraitRoll.TN'}}</span>
    <div class="dlc-tn-picker" role="radiogroup" aria-label="{{localize 'DEADLANDS.Dialog.TraitRoll.TN'}}">
      {{#each tnChoices as |choice|}}
      <label class="dlc-tn-option">
        <input type="radio" name="tn" value="{{choice.value}}" {{#if choice.default}}checked{{/if}} />
        <span class="dlc-tn-option-value dlc-num">{{choice.value}}</span>
        <span class="dlc-tn-option-label">{{localize choice.label}}</span>
      </label>
      {{/each}}
    </div>
  </div>

  <div class="dlc-dialog-field">
    <span class="dlc-dialog-field-label">{{localize 'DEADLANDS.Dialog.TraitRoll.Modifier'}}</span>
    <div class="dlc-stepper">
      <button type="button" class="dlc-stepper-btn" data-action="stepDown" data-for="modifier"
        aria-label="{{localize 'DEADLANDS.Dialog.Stepper.Decrease'}}">−</button>
      <input class="dlc-stepper-input dlc-num" type="number" name="modifier" value="0" />
      <button type="button" class="dlc-stepper-btn" data-action="stepUp" data-for="modifier"
        aria-label="{{localize 'DEADLANDS.Dialog.Stepper.Increase'}}">+</button>
    </div>
  </div>

  {{#if maxWhite}}
  <div class="dlc-dialog-field">
    <span class="dlc-dialog-field-label">{{localize 'DEADLANDS.Dialog.TraitRoll.WhiteChips'}}</span>
    <div class="dlc-spend-row">
      <button type="button" class="dlc-stepper-btn" data-action="stepDown" data-for="whiteChips"
        aria-label="{{localize 'DEADLANDS.Dialog.Stepper.Decrease'}}">−</button>
      <span class="dlc-chip dlc-chip-white">
        <input class="dlc-chip-token dlc-num" type="number" name="whiteChips" value="0"
          min="0" max="{{maxWhite}}" />
      </span>
      <button type="button" class="dlc-stepper-btn" data-action="stepUp" data-for="whiteChips"
        aria-label="{{localize 'DEADLANDS.Dialog.Stepper.Increase'}}">+</button>
      <span class="dlc-spend-avail">{{localize 'DEADLANDS.Dialog.Stepper.Of'}} {{maxWhite}}</span>
    </div>
  </div>
  {{/if}}
</form>
