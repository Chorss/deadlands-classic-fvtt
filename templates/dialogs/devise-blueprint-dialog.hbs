{{!-- Dialog: devise blueprint OR construct gizmo (Mad Scientist). --}}
<form class="dlc-dialog-form">
  {{#if isConstruction}}
  <div class="dlc-dialog-kicker">{{localize "DEADLANDS.MadScientist.Dialog.ConstructIntro"}}</div>
  <div class="dlc-dialog-title">{{gizmoName}}</div>
  <p class="dlc-dialog-sub">
    {{localize "DEADLANDS.MadScientist.GizmoTable.ConstructionTN"}}:
    <span class="dlc-num">{{constructionTN}}</span>
  </p>
  {{else}}
  <div class="dlc-dialog-kicker">{{localize "DEADLANDS.MadScientist.Dialog.BlueprintIntro"}}</div>
  <div class="dlc-dialog-title">{{gizmoName}}</div>
  <p class="dlc-dialog-sub">
    {{localize "DEADLANDS.MadScientist.Blueprint.TN"}}:
    <span class="dlc-num">{{blueprintTN}}</span>
  </p>
  {{/if}}

  {{> "systems/deadlands-classic/templates/dialogs/parts/modifier-stepper.hbs" labelKey="DEADLANDS.Dialog.Modifier"}}
</form>
