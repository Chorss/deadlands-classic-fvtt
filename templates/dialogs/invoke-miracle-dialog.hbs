{{!-- Dialog: invoke a miracle (Blessed). --}}
<form class="dlc-dialog-form">
  <div class="dlc-dialog-kicker">{{localize "DEADLANDS.Blessed.Dialog.InvokeIntro"}}</div>
  <div class="dlc-dialog-title">{{miracleName}}</div>
  <p class="dlc-dialog-sub">
    {{localize "DEADLANDS.Blessed.MiracleTable.TN"}}: <span class="dlc-num">{{tn}}</span>
  </p>

  {{> "systems/deadlands-classic/templates/dialogs/parts/modifier-stepper.hbs" labelKey="DEADLANDS.Dialog.Modifier"}}

  {{#if maxWhite}}
  {{> "systems/deadlands-classic/templates/dialogs/parts/chip-spend.hbs" labelKey="DEADLANDS.Dialog.WhiteChips" availMode="inline" availKey="DEADLANDS.Blessed.Dialog.Available"}}
  {{/if}}
</form>
