{{!-- Dialog: perform a ritual to earn Appeasement (Shaman). --}}
<form class="dlc-dialog-form">
  <div class="dlc-dialog-kicker">{{localize "DEADLANDS.Shaman.Dialog.RitualIntro"}}</div>
  <div class="dlc-dialog-title">{{favorName}}</div>
  <p class="dlc-dialog-sub">
    {{localize ritualTypeLabel}} —
    {{localize "DEADLANDS.Shaman.FavorTable.TN"}}: <span class="dlc-num">{{ritualTN}}</span>
  </p>

  {{> "systems/deadlands-classic/templates/dialogs/parts/modifier-stepper.hbs" labelKey="DEADLANDS.Dialog.Modifier"}}
</form>
